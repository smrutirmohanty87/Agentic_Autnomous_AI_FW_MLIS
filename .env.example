# ========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control
# 
# Usage:
#   TEST_ENV=UAT2 npx playwright test        # Run tests in UAT2
#   TEST_ENV=SIT2 npx playwright test        # Run tests in SIT2
# 
# Default environment: UAT2 (if TEST_ENV is not specified)
# ========================================

# ========================================
# DEFAULT ENVIRONMENT: UAT2
# (Active environment when TEST_ENV is not specified)
# ========================================

# MLIS Broker Portal (Experience Cloud)
MLIS_PORTAL_URL=https://dualgroup--uat2.sandbox.my.site.com/mlisportal/

# Salesforce Lightning
SALESFORCE_LIGHTNING_URL=https://dualgroup--uat2.sandbox.my.salesforce.com/

# Broker Portal credentials
BROKER_USERNAME=your-broker-username@example.com
BROKER_PASSWORD=your-broker-password

# Salesforce credentials
SALESFORCE_USERNAME=your-salesforce-username@example.com
SALESFORCE_PASSWORD=your-salesforce-password


# ========================================
# SIT2 ENVIRONMENT
# ========================================
# Usage: TEST_ENV=SIT2 npx playwright test

SIT2_MLIS_PORTAL_URL=https://dualgroup--sitp.sandbox.my.site.com/mlisportal/broker-zone
SIT2_SALESFORCE_LIGHTNING_URL=https://dualgroup--sitp.sandbox.lightning.force.com/
SIT2_BROKER_USERNAME=your-sit2-broker-username@example.com
SIT2_BROKER_PASSWORD=your-sit2-broker-password
SIT2_SALESFORCE_USERNAME=your-sit2-salesforce-username@example.com
SIT2_SALESFORCE_PASSWORD=your-sit2-salesforce-password


# ========================================
# UAT2 ENVIRONMENT (EXPLICIT)
# ========================================
# Usage: TEST_ENV=UAT2 npx playwright test

UAT2_MLIS_PORTAL_URL=https://dualgroup--uat2.sandbox.my.site.com/mlisportal/
UAT2_SALESFORCE_LIGHTNING_URL=https://dualgroup--uat2.sandbox.my.salesforce.com/
UAT2_BROKER_USERNAME=your-uat2-broker-username@example.com
UAT2_BROKER_PASSWORD=your-uat2-broker-password
UAT2_SALESFORCE_USERNAME=your-uat2-salesforce-username@example.com
UAT2_SALESFORCE_PASSWORD=your-uat2-salesforce-password


# ========================================
# TEST CONFIGURATION
# ========================================

# CI/CD Flag (set to 'true' on CI systems)
CI=false

# Optional: Override default timeout (in milliseconds)
# TEST_TIMEOUT=30000

# Optional: Number of retry attempts (CI only)
# TEST_RETRIES=2

# Optional: Set log level (debug|info|warn|error)
# LOG_LEVEL=info
